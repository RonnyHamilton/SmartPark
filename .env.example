# ---------------------------------------------------------------------------
# SmartPark local configuration template. Copy to .env and edit.
# NEVER commit .env or real credentials.
# ---------------------------------------------------------------------------

# --- PostgreSQL (Docker Compose) ---
POSTGRES_DB=smartpark
POSTGRES_USER=smartpark
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_PORT=5432
ADMINER_PORT=8085

# --- Backend (Spring Boot) ---
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/smartpark
DB_USERNAME=smartpark
DB_PASSWORD=replace-with-a-strong-local-password

# Generate with: openssl rand -base64 48
# Must decode to at least 32 bytes. The development default in application.yml is NOT production safe.
JWT_SECRET=replace-with-at-least-48-random-characters-generated-securely
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Set true only when serving over HTTPS. Refresh cookies are HttpOnly + SameSite=Strict.
COOKIE_SECURE=false

# Seed demo facilities/bookings/users on startup (dev only). Disable in production.
SEED_DEMO_DATA=true

# Optional one-time production admin bootstrap (leave both empty in development).
# Password: 10-72 chars with upper-case, lower-case and a digit. Remove after first start.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=SmartPark Administrator

# Expose password-reset tokens in API responses (development only, never production).
DEV_EXPOSE_RESET_TOKEN=true

# --- Optional SMTP (booking confirmation email) ---
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@smartpark.local

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
